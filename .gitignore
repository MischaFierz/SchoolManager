# Bauergebnisse. Alles hier entsteht neu aus dem Quelltext
# (dotnet build, publish.cmd, build-installer.cmd) und gehoert
# deshalb nicht in die Versionsverwaltung.
[Bb]in/
[Oo]bj/

# Die fertige EXE und das Installationspaket, je rund 60 MB und bei
# jedem Bauvorgang neu. Veroeffentlicht werden sie als GitHub-Release,
# siehe RELEASES.md (nur lokal).
publish/

# Notizen nur fuer die Entwicklung: bleiben lokal und kommen nicht ins Repository.
RELEASES.md
ENTWICKLER.md

# Daten des School-Manager-Servers: Benutzer, Passwort-Abdrücke, Anmeldungen.
# Gehören auf den Server und nie in ein Repository.
SchoolManager.Server/App_Data/
*.db
*.db-shm
*.db-wal
appsettings.Production.json

# Visual Studio und Rider: eigene Einstellungen und Zwischenstaende
.vs/
*.user
*.suo
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/httpRequests/

# NuGet
*.nupkg
packages/

# Betriebssystem
Thumbs.db
desktop.ini
