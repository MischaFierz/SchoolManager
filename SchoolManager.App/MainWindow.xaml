<Window x:Class="SchoolManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="School Manager"
        Icon="app.ico"
        Height="760" Width="1040"
        MinHeight="600" MinWidth="880"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Seitennavigation ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kopf -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,24">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource Accent}"
                            VerticalAlignment="Center">
                        <Path Data="M 11,3 L 20.5,7.4 L 11,11.8 L 1.5,7.4 Z M 5.5,9.2 V 13.4 C 5.5,15.4 16.5,15.4 16.5,13.4 V 9.2 M 19,8.3 V 13.6"
                              Stroke="{StaticResource AccentText}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="School Manager" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                </StackPanel>

                <!-- Seiten -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOrders" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Aufträge" Checked="Nav_Checked"
                                 Tag="M4,3 H14 V17 H4 Z M7.5,3 V1.5 H10.5 V3 M6.5,8 H11.5 M6.5,11.5 H11.5 M6.5,15 H9.5" />
                    <RadioButton x:Name="NavTasks" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Aufgaben" Checked="Nav_Checked"
                                 Tag="M1.5,3 H8 M1.5,7.5 H8 M1.5,12 H6 M10.5,8 L13,10.5 L17,4" />
                    <RadioButton x:Name="NavHomework" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Hausaufgaben" Checked="Nav_Checked"
                                 Tag="M2,4 C2,3 3.2,2.5 5,2.5 C7,2.5 8.3,3.2 9,4 C9.7,3.2 11,2.5 13,2.5 C14.8,2.5 16,3 16,4 V14.5 C16,13.5 14.8,13 13,13 C11,13 9.7,13.7 9,14.5 C8.3,13.7 7,13 5,13 C3.2,13 2,13.5 2,14.5 Z M9,4 V14.5" />
                    <RadioButton x:Name="NavExams" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Prüfungen" Checked="Nav_Checked"
                                 Tag="M9,1.5 L11.2,6.6 L16.5,7.1 L12.5,10.7 L13.7,16 L9,13.2 L4.3,16 L5.5,10.7 L1.5,7.1 L6.8,6.6 Z" />
                    <RadioButton x:Name="NavCalendar" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Kalender" Checked="Nav_Checked"
                                 Tag="M2,4 H16 V16 H2 Z M2,7.5 H16 M6,2.2 V5 M12,2.2 V5" />
                    <RadioButton x:Name="NavTeachers" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Lehrkräfte" Checked="Nav_Checked"
                                 Tag="M6,5.5 A3,3 0 1,1 12,5.5 A3,3 0 1,1 6,5.5 M2.5,16.5 C2.5,11.5 15.5,11.5 15.5,16.5" />
                    <RadioButton x:Name="NavMail" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="E-Mail" Checked="Nav_Checked"
                                 Tag="M1,3 H17 V13 H1 Z M1,3 L9,9 L17,3" />
                    <RadioButton x:Name="NavTodo" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="To-Do" Checked="Nav_Checked"
                                 Tag="M1.5,4 H16.5 M1.5,9 H16.5 M1.5,14 H11" />
                    <RadioButton x:Name="NavNotes" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Notizen" Checked="Nav_Checked"
                                 Tag="M2,1 H15 V17 H2 Z M5,5 H12 M5,9 H12 M5,13 H9" />
                </StackPanel>

                <!-- Fuss der Seitenleiste -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <Border Height="1" Background="{StaticResource Line}" Margin="20,0,20,10" />
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Content="Einstellungen" Checked="Nav_Checked"
                                 Tag="M1,5 H17 M1,12 H17 M6,2 V8 M12,9 V15" />
                    <!-- Siebenmal darauf klicken schaltet den Entwicklermodus frei -->
                    <TextBlock x:Name="VersionText" Margin="20,12,20,0"
                               AutomationProperties.AutomationId="VersionLabel"
                               FontFamily="{StaticResource UiFont}" FontSize="11"
                               Foreground="{StaticResource TextFaint}"
                               MouseLeftButtonUp="VersionText_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Inhalt ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hinweisstreifen, wenn der Postausgang beim Start nicht erreichbar
                 war. Er verschwindet von selbst, sobald der Versand wieder geht. -->
            <StackPanel Grid.Row="0">

            <Border x:Name="MailWarningBanner" Visibility="Collapsed"
                    Background="#33D98C8C" BorderBrush="{StaticResource Error}"
                    BorderThickness="1" CornerRadius="8" Margin="26,18,26,0" Padding="12,9"
                    AutomationProperties.AutomationId="MailWarningBanner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource Error}" />

                    <TextBlock x:Name="MailWarningText" Grid.Column="1" Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="MailWarningText"
                               FontFamily="{StaticResource UiFont}" FontSize="12.5"
                               Foreground="{StaticResource Error}"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2" Content="Einstellungen öffnen"
                            Style="{StaticResource GhostButton}" FontSize="12"
                            Foreground="{StaticResource Error}"
                            Click="MailWarningSettings_Click" />

                    <Button Grid.Column="3" Content="✕" Margin="4,0,0,0"
                            Style="{StaticResource GhostButton}" FontSize="12"
                            Foreground="{StaticResource Error}"
                            ToolTip="Hinweis bis zum nächsten Start ausblenden"
                            Click="MailWarningClose_Click" />
                </Grid>
            </Border>

            <!-- Hinweis auf ein bereitstehendes Update. Er steht hier im
                 Fenster und nicht mehr als eigenes Fenster unten rechts am
                 Bildschirm: Wer arbeitet, soll nicht angesprungen werden. -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed"
                    Background="#3363666C" BorderBrush="{StaticResource AccentHover}"
                    BorderThickness="1" CornerRadius="8" Margin="26,18,26,0" Padding="12,9"
                    AutomationProperties.AutomationId="UpdateBanner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource AccentHover}" />

                    <TextBlock x:Name="UpdateBannerText" Grid.Column="1" Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="UpdateBannerText"
                               FontFamily="{StaticResource UiFont}" FontSize="12.5"
                               Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2" Content="Jetzt aktualisieren"
                            Style="{StaticResource GhostButton}" FontSize="12"
                            AutomationProperties.AutomationId="UpdateBannerButton"
                            Click="UpdateBannerSettings_Click" />

                    <Button Grid.Column="3" Content="✕" Margin="4,0,0,0"
                            Style="{StaticResource GhostButton}" FontSize="12"
                            ToolTip="Hinweis bis zum nächsten Start ausblenden"
                            Click="UpdateBannerClose_Click" />
                </Grid>
            </Border>

            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,24,26,0" />

            <!-- Gemeinsame Fussleiste fuer Statusmeldungen -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="26,16,26,18">
                <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4"
                        Background="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" FontSize="12.5"
                           Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           Text="Bereit" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
