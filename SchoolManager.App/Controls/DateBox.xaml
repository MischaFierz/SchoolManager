<UserControl x:Class="SchoolManager.App.Controls.DateBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <UserControl.Resources>
        <!-- Ein Tag im Monatsblatt: flach, quadratisch, ohne Rahmen. -->
        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Die Pfeile für den Monatswechsel. -->
        <Style x:Key="MonthArrow" TargetType="Button" BasedOn="{StaticResource DayCell}">
            <Setter Property="Width" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Field"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl},
                                Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 ToolTip="Datum tt.mm.jjjj - oder rechts aus dem Kalender wählen"
                 LostFocus="Field_LostFocus" />

        <!-- Öffnet das Monatsblatt. -->
        <Button x:Name="OpenButton" Grid.Column="1" Width="30" Margin="4,0,0,0"
                Style="{StaticResource DayCell}"
                AutomationProperties.AutomationId="DateBoxOpen"
                ToolTip="Datum im Kalender auswählen"
                Click="Open_Click">
            <Path Data="M2,3 H14 V15 H2 Z M2,6.5 H14 M5.5,1.5 V4.2 M10.5,1.5 V4.2"
                  Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>

        <Popup x:Name="MonthPopup" PlacementTarget="{Binding ElementName=Field}"
               Placement="Bottom" HorizontalOffset="0" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="MonthPopup_Closed">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineHover}"
                    BorderThickness="1" CornerRadius="9" Padding="10,8,10,10">
                <StackPanel Width="252">
                    <!-- Kopf: Monat blättern -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="‹" Style="{StaticResource MonthArrow}"
                                AutomationProperties.AutomationId="DateBoxPrevMonth"
                                ToolTip="Vorheriger Monat" Click="PreviousMonth_Click" />

                        <TextBlock x:Name="MonthLabel" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" />

                        <Button Grid.Column="2" Content="›" Style="{StaticResource MonthArrow}"
                                AutomationProperties.AutomationId="DateBoxNextMonth"
                                ToolTip="Nächster Monat" Click="NextMonth_Click" />
                    </Grid>

                    <!-- Mo Di Mi Do Fr Sa So -->
                    <UniformGrid x:Name="DayNames" Columns="7" Margin="0,6,0,2" />

                    <!-- Sechs Wochen, damit das Blatt beim Blättern nicht springt. -->
                    <UniformGrid x:Name="DayGrid" Columns="7" Rows="6" />

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="Heute" HorizontalAlignment="Left"
                                Style="{StaticResource GhostButton}" FontSize="11.5"
                                AutomationProperties.AutomationId="DateBoxToday"
                                Click="Today_Click" />

                        <Button Grid.Column="1" Content="Kein Datum"
                                Style="{StaticResource GhostButton}" FontSize="11.5"
                                AutomationProperties.AutomationId="DateBoxClear"
                                ToolTip="Das Datum wieder entfernen"
                                Click="Clear_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
