<UserControl x:Class="SchoolManager.App.Pages.HomeworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SchoolManager.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Hausaufgaben" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Text="Keine Hausaufgaben" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Neue Hausaufgabe -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTitleBox" KeyDown="NewTitleBox_KeyDown"
                             AutomationProperties.AutomationId="NewTitleBox"
                             ToolTip="Hausaufgabe eintippen und mit Enter hinzufügen" />
                    <Button Grid.Column="1" Content="Hinzufügen" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.AutomationId="AddButton"
                            Click="Add_Click" />
                    <ComboBox x:Name="FilterBox" Grid.Column="2" Width="140" Margin="10,0,0,0"
                              AutomationProperties.AutomationId="FilterBox"
                              SelectionChanged="FilterBox_SelectionChanged" />
                    <Button x:Name="DeleteButton" Grid.Column="3" Content="Löschen" Margin="10,0,0,0"
                            Click="Delete_Click" IsEnabled="False" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Liste -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <ListBox x:Name="HomeworkList" SelectionChanged="HomeworkList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Als erledigt markieren" />

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="0.75" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Error}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyListText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Hausaufgaben.&#10;Oben eintippen und mit Enter hinzufügen." />
                    </Grid>

                    <!-- Bearbeiten -->
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto"
                                      c:WheelScroll.Forward="True"
                                      DataContext="{Binding SelectedItem, ElementName=HomeworkList}">
                            <StackPanel>
                                <TextBlock Text="Hausaufgabe" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding DueDescription}" Style="{StaticResource Hint}"
                                           Margin="0,4,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="TitleBox"
                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Fach"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="SubjectBox"
                                             Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fällig am"
                                               Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                        <c:DateBox Width="176"
                                                   AutomationProperties.AutomationId="DueBox"
                                                   Text="{Binding DueText, Mode=TwoWay}" />
                                        <CheckBox Content="Erledigt" Margin="16,0,0,0"
                                                  AutomationProperties.AutomationId="DoneBox"
                                                  IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Notiz"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                                               Margin="0,8,14,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" MinHeight="90"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.AutomationId="NotesBox"
                                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,14" />

                                <TextBlock Text="Verweis" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Die Hausaufgabe kann auf einen Auftrag, eine Aufgabe oder ein Leistungsdetail zeigen." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Zeigt auf" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LinkBox" Grid.Column="1"
                                              AutomationProperties.AutomationId="LinkBox"
                                              SelectionChanged="LinkBox_SelectionChanged" />
                                    <Button x:Name="OpenLinkButton" Grid.Column="2" Content="Öffnen"
                                            Margin="10,0,0,0" IsEnabled="False"
                                            AutomationProperties.AutomationId="OpenLinkButton"
                                            Click="OpenLink_Click" />
                                </Grid>

                                <TextBlock x:Name="LinkInfoText" Style="{StaticResource Hint}" Margin="110,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock x:Name="NoSelectionText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Links eine Hausaufgabe auswählen&#10;oder oben eine neue anlegen." />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
