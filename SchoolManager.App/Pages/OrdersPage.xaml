<UserControl x:Class="SchoolManager.App.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SchoolManager.App"
             xmlns:c="clr-namespace:SchoolManager.App.Controls">
    <UserControl.Resources>
        <app:DoneGroupNameConverter x:Key="DoneGroupName" />

        <!-- Überschrift über „Offen“ bzw. „Abgeschlossen“ in der Liste -->
        <DataTemplate x:Key="DoneGroupHeader">
            <StackPanel Margin="0,12,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name, Converter={StaticResource DoneGroupName}}"
                               FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextFaint}" />
                    <TextBlock Grid.Column="1" Text="{Binding ItemCount}"
                               FontFamily="{StaticResource UiFont}" FontSize="11"
                               Foreground="{StaticResource TextFaint}" />
                </Grid>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,5,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Aufträge" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Text="Keine Aufträge" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Werkzeugleiste -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NewOrderButton" Content="Neuer Auftrag"
                            Style="{StaticResource AccentButton}" Click="NewOrder_Click" />
                    <Button x:Name="DeleteOrderButton" Grid.Column="2" Content="Auftrag löschen"
                            Click="DeleteOrder_Click" IsEnabled="False" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Liste der Aufträge -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <ListBox x:Name="OrderList" SelectionChanged="OrderList_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource DoneGroupHeader}" />
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Auftrag als fertig markieren" />

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DoneSummary}" FontSize="11" Opacity="0.75"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}"
                                                   VerticalAlignment="Center" FontSize="11.5" Opacity="0.85" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyListText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Aufträge.&#10;Oben mit „Neuer Auftrag“ anfangen." />
                    </Grid>

                    <!-- Auftrag bearbeiten -->
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedItem, ElementName=OrderList}">
                            <StackPanel>
                                <TextBlock Text="Auftrag" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding EstimateSummary}" Style="{StaticResource Hint}"
                                           Margin="0,4,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="OrderTitle"
                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Auftraggeber"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="OrderClient"
                                             Text="{Binding Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fach"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="OrderSubject"
                                             Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fertig"
                                               Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                                Margin="0,0,0,12">
                                        <CheckBox Content="Auftrag ist abgeschlossen"
                                                  AutomationProperties.AutomationId="OrderDone"
                                                  IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Benötigte Zeit"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                                               Margin="0,7,14,0" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
                                        <CheckBox Content="Benötigte Arbeitszeit angeben"
                                                  AutomationProperties.AutomationId="OrderHasEstimate"
                                                  IsChecked="{Binding HasEstimate, Mode=TwoWay}" />
                                        <TextBox Width="140" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                 IsEnabled="{Binding HasEstimate}"
                                                 ToolTip="Zum Beispiel 90, 1:30 oder 1,5h"
                                                 LostFocus="DurationBox_LostFocus"
                                                 AutomationProperties.AutomationId="OrderEstimate"
                                                 Text="{Binding EstimateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Enddatum"
                                               Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                                                Margin="0,0,0,12">
                                        <c:DateBox Width="176"
                                                   AutomationProperties.AutomationId="OrderDue"
                                                   Text="{Binding DueText, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding DueDescription}" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Details" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <TextBox MinHeight="90" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="OrderDetails"
                                         Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,14" />

                                <!-- Aufgaben dieses Auftrags -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Aufgaben in diesem Auftrag"
                                               Style="{StaticResource SectionTitle}" Margin="0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Neue Aufgabe"
                                            AutomationProperties.AutomationId="NewTaskButton"
                                            Click="NewTask_Click" />
                                </Grid>

                                <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Aufgabe als fertig markieren" />

                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DoneSummary}" FontSize="11"
                                                                   Foreground="{StaticResource TextFaint}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextMuted}" />

                                                    <Button Grid.Column="3" Content="Öffnen"
                                                            Style="{StaticResource GhostButton}" FontSize="11.5"
                                                            Click="OpenTask_Click"
                                                            ToolTip="Aufgabe mit ihren Leistungsdetails öffnen" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoTasksText" Style="{StaticResource Hint}"
                                           Text="Noch keine Aufgaben in diesem Auftrag." />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock x:Name="NoSelectionText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Links einen Auftrag auswählen&#10;oder einen neuen anlegen." />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
