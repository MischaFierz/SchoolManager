<UserControl x:Class="SchoolManager.App.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Notizen" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CountText" Style="{StaticResource PageSubtitle}" Text="Keine Notizen" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Liste der Notizen -->
                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="NewNoteButton" Grid.Row="0" Content="Neue Notiz" Margin="0,0,0,10"
                            Style="{StaticResource AccentButton}" Click="NewNote_Click" />

                    <Grid Grid.Row="1">
                        <ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyListText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Notizen." />
                    </Grid>
                </Grid>

                <!-- Bearbeiten -->
                <Grid Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=NotesList}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Titel und Fach, jeweils beschriftet; das Fach darf leer bleiben. -->
                    <Grid x:Name="EditorHeader" Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Titel" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBlock Grid.Column="1" Text="Fach" Style="{StaticResource FieldLabel}"
                                   Margin="12,0,0,5" />

                        <TextBox x:Name="TitleBox" Grid.Row="1" FontSize="14"
                                 AutomationProperties.AutomationId="NoteTitleBox"
                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Überschrift der Notiz" />

                        <TextBox x:Name="SubjectBox" Grid.Row="1" Grid.Column="1" FontSize="14"
                                 Margin="12,0,0,0"
                                 AutomationProperties.AutomationId="NoteSubjectBox"
                                 Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Fach, etwa Mathematik - darf leer bleiben" />
                    </Grid>

                    <TextBlock x:Name="BodyLabel" Grid.Row="1" Text="Text"
                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                               VerticalAlignment="Top" />

                    <TextBox x:Name="BodyBox" Grid.Row="2"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Der Inhalt der Notiz"
                             Text="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock x:Name="NoSelectionText" Grid.Row="0" Grid.RowSpan="3"
                               Style="{StaticResource Placeholder}" VerticalAlignment="Center"
                               Text="Links eine Notiz auswählen&#10;oder eine neue anlegen." />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SaveHintText" VerticalAlignment="Center"
                       FontFamily="{StaticResource UiFont}" FontSize="11.5"
                       Foreground="{StaticResource TextFaint}"
                       Text="Änderungen werden automatisch gespeichert." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DeleteNoteButton" Content="Notiz löschen" Click="DeleteNote_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
