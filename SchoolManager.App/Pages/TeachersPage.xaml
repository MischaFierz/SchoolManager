<UserControl x:Class="SchoolManager.App.Pages.TeachersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SchoolManager.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Lehrkräfte" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Text="Keine Lehrkräfte" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Werkzeugleiste -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewNameBox" KeyDown="NewNameBox_KeyDown"
                             AutomationProperties.AutomationId="NewNameBox"
                             ToolTip="Name eintippen und mit Enter hinzufügen" />
                    <Button Grid.Column="1" Content="Hinzufügen" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.AutomationId="AddButton"
                            Click="Add_Click" />
                    <Button x:Name="DeleteButton" Grid.Column="2" Content="Löschen" Margin="10,0,0,0"
                            AutomationProperties.AutomationId="DeleteButton"
                            Click="Delete_Click" IsEnabled="False" />
                    <Button Grid.Column="3" Content="Exportieren…" Margin="10,0,0,0"
                            AutomationProperties.AutomationId="ExportButton"
                            Click="Export_Click" ToolTip="Liste als CSV-Datei speichern" />
                    <Button Grid.Column="4" Content="Importieren…" Margin="10,0,0,0"
                            AutomationProperties.AutomationId="ImportButton"
                            Click="Import_Click" ToolTip="Liste aus einer CSV-Datei einlesen" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Liste -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <ListBox x:Name="TeacherList" SelectionChanged="TeacherList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubtitleText}" FontSize="11" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyListText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Lehrkräfte.&#10;Oben Namen eintippen&#10;und mit Enter hinzufügen." />
                    </Grid>

                    <!-- Bearbeiten -->
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto"
                                      c:WheelScroll.Forward="True"
                                      DataContext="{Binding SelectedItem, ElementName=TeacherList}">
                            <StackPanel>
                                <TextBlock Text="Lehrkraft" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Hint}"
                                           Margin="0,4,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="NameBox"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Kürzel"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Width="140"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="ShortNameBox"
                                             ToolTip="Wie im Stundenplan, etwa HuDa"
                                             Text="{Binding ShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fach"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="SubjectBox"
                                             Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="E-Mail"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                             AutomationProperties.AutomationId="EmailBox"
                                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Telefon / Raum"
                                               Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                        <TextBox Width="170"
                                                 AutomationProperties.AutomationId="PhoneBox"
                                                 Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="120" Margin="10,0,0,0"
                                                 AutomationProperties.AutomationId="RoomBox"
                                                 Text="{Binding Room, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Notiz"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                                               Margin="0,8,14,0" />
                                    <TextBox Grid.Row="5" Grid.Column="1" MinHeight="80"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.AutomationId="NotesBox"
                                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,14" />

                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Lehrkräfte mit E-Mail-Adresse stehen auf der E-Mail-Seite in der Empfängerauswahl." />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ComposeButton" Content="E-Mail an diese Lehrkraft"
                                            AutomationProperties.AutomationId="ComposeButton"
                                            Click="Compose_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock x:Name="NoSelectionText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Links eine Lehrkraft auswählen&#10;oder oben eine neue anlegen." />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
