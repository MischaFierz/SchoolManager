<UserControl x:Class="SchoolManager.App.Pages.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Erledigte Aufgaben werden durchgestrichen und blasser dargestellt -->
        <Style x:Key="TodoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="To-Do" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CountText" Style="{StaticResource PageSubtitle}" Text="Keine Aufgaben" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Neue Aufgabe -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <!-- Über jedem Feld steht, was hineingehört; ohne das rät
                         man bei drei gleich aussehenden Kästchen. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Neue Aufgabe" Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,5" />
                        <TextBlock Grid.Column="1" Text="Fach" Style="{StaticResource FieldLabel}"
                                   Margin="10,0,0,5" />
                        <TextBlock Grid.Column="2" Text="Bis wann" Style="{StaticResource FieldLabel}"
                                   Margin="10,0,0,5" />

                        <TextBox x:Name="NewTodoBox" Grid.Row="1" KeyDown="NewTodoBox_KeyDown"
                                 ToolTip="Was zu tun ist - eintippen und mit Enter hinzufügen" />

                        <TextBox x:Name="NewSubjectBox" Grid.Row="1" Grid.Column="1"
                                 Width="120" Margin="10,0,0,0"
                                 KeyDown="NewTodoBox_KeyDown"
                                 AutomationProperties.AutomationId="NewTodoSubjectBox"
                                 ToolTip="Fach, etwa Mathematik - darf leer bleiben" />

                        <TextBox x:Name="NewDueBox" Grid.Row="1" Grid.Column="2"
                                 Width="105" Margin="10,0,0,0"
                                 KeyDown="NewTodoBox_KeyDown"
                                 AutomationProperties.AutomationId="NewTodoDueBox"
                                 ToolTip="Datum im Format TT.MM.JJJJ - darf leer bleiben" />

                        <Button x:Name="AddTodoButton" Grid.Row="1" Grid.Column="3" Content="Hinzufügen"
                                Margin="10,0,0,0"
                                Style="{StaticResource AccentButton}" Click="Add_Click" />

                        <ComboBox x:Name="FilterBox" Grid.Row="1" Grid.Column="4" Width="130"
                                  Margin="10,0,0,0"
                                  ToolTip="Welche Aufgaben die Liste zeigt"
                                  SelectionChanged="FilterBox_SelectionChanged" />
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Fach und Datum sind freiwillig; das Datum im Format TT.MM.JJJJ, etwa 24.09.2026. Es erscheint bewusst nicht im Kalender - es gilt nur für die Liste und die Erinnerungen." />
                </StackPanel>

                <!-- Liste -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,5,3,5">
                            <ItemsControl x:Name="TodoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                                Padding="9,7" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Als erledigt markieren" />

                                                <TextBlock Grid.Column="1" Margin="11,0,10,0"
                                                           Text="{Binding Text}"
                                                           Style="{StaticResource TodoText}" />

                                                <!-- Die Beschriftung steht in jeder Zeile, statt als
                                                     Kopfzeile über der Liste: Die rutscht mit dem
                                                     Rollbalken aus der Flucht, das hier nicht. -->
                                                <TextBlock Grid.Column="2" Text="Fach"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                                           Foreground="{StaticResource TextFaint}" />

                                                <TextBox Grid.Column="3" Width="110" FontSize="11.5"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"
                                                         Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Fach, etwa Mathematik - darf leer bleiben" />

                                                <TextBlock Grid.Column="4" Text="bis"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                                           Foreground="{StaticResource TextFaint}" />

                                                <TextBox Grid.Column="5" Width="95" FontSize="11.5"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Text="{Binding DueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Datum im Format TT.MM.JJJJ - darf leer bleiben" />

                                                <TextBlock Grid.Column="6" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" MinWidth="118"
                                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                                           Text="{Binding DueDescription}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource TextFaint}" />
                                                            <Style.Triggers>
                                                                <!-- Überfälliges sticht hervor. -->
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Grid.Column="7" Content="Löschen"
                                                        Style="{StaticResource GhostButton}"
                                                        FontSize="11.5"
                                                        Click="Delete_Click"
                                                        ToolTip="Aufgabe löschen" />
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource SurfaceHover}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Aufgaben.&#10;Oben eintippen und mit Enter hinzufügen." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearDoneButton" Content="Erledigte entfernen" Click="ClearDone_Click" />
        </StackPanel>
    </Grid>
</UserControl>
