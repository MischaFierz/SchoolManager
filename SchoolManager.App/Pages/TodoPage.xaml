<UserControl x:Class="SchoolManager.App.Pages.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Erledigte Aufgaben werden durchgestrichen und blasser dargestellt -->
        <Style x:Key="TodoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="To-Do" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CountText" Style="{StaticResource PageSubtitle}" Text="Keine Aufgaben" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Neue Aufgabe -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTodoBox" KeyDown="NewTodoBox_KeyDown"
                             ToolTip="Aufgabe eintippen und mit Enter hinzufügen" />
                    <Button x:Name="AddTodoButton" Grid.Column="1" Content="Hinzufügen" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}" Click="Add_Click" />
                    <ComboBox x:Name="FilterBox" Grid.Column="2" Width="130" Margin="10,0,0,0"
                              SelectionChanged="FilterBox_SelectionChanged" />
                </Grid>

                <!-- Liste -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,5,3,5">
                            <ItemsControl x:Name="TodoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                                Padding="9,7" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Als erledigt markieren" />

                                                <TextBlock Grid.Column="1" Margin="11,0,10,0"
                                                           Text="{Binding Text}"
                                                           Style="{StaticResource TodoText}" />

                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           FontFamily="{StaticResource UiFont}" FontSize="11"
                                                           Foreground="{StaticResource TextFaint}"
                                                           Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" />

                                                <Button Grid.Column="3" Content="Löschen"
                                                        Style="{StaticResource GhostButton}"
                                                        FontSize="11.5"
                                                        Click="Delete_Click"
                                                        ToolTip="Aufgabe löschen" />
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource SurfaceHover}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyText" Style="{StaticResource Placeholder}"
                                   VerticalAlignment="Center"
                                   Text="Noch keine Aufgaben.&#10;Oben eintippen und mit Enter hinzufügen." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearDoneButton" Content="Erledigte entfernen" Click="ClearDone_Click" />
        </StackPanel>
    </Grid>
</UserControl>
