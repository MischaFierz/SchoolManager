<UserControl x:Class="SchoolManager.App.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SchoolManager.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Protokoll" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Aufgezeichnete Fehler und was diese Fassung Neues bringt"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Die beiden Reiter -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="ErrorsTab" GroupName="LogTabs" Content="Fehler"
                                 Style="{StaticResource GhostToggle}" IsChecked="True"
                                 AutomationProperties.AutomationId="ErrorsTab"
                                 Checked="LogTab_Checked" />
                    <RadioButton x:Name="ChangelogTab" GroupName="LogTabs" Content="Changelog"
                                 Style="{StaticResource GhostToggle}" Margin="6,0,0,0"
                                 AutomationProperties.AutomationId="ChangelogTab"
                                 Checked="LogTab_Checked" />

                    <TextBlock x:Name="TabHintText" VerticalAlignment="Center" Margin="16,0,0,0"
                               FontFamily="{StaticResource UiFont}" FontSize="11.5"
                               Foreground="{StaticResource TextFaint}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="7" Padding="12">
                    <Grid>
                        <!-- Fehler -->
                        <Grid x:Name="ErrorsPanel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" c:WheelScroll.Forward="True">
                                <ItemsControl x:Name="ErrorList"
                                              AutomationProperties.AutomationId="ErrorList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Header}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextFaint}" />
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Error}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="ErrorsEmptyText" Style="{StaticResource Placeholder}"
                                       VerticalAlignment="Center"
                                       Text="Noch kein Fehler aufgezeichnet.&#10;Hier steht künftig jede Fehlermeldung mit Zeitpunkt." />
                        </Grid>

                        <!-- Changelog -->
                        <ScrollViewer x:Name="ChangelogPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" c:WheelScroll.Forward="True">
                            <StackPanel>
                                <TextBlock x:Name="ChangelogHeaderText"
                                           FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                           Foreground="{StaticResource TextFaint}"
                                           TextWrapping="Wrap" Margin="0,0,0,12" />

                                <ItemsControl x:Name="ChangelogList"
                                              AutomationProperties.AutomationId="ChangelogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="{Binding Header}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text}"
                                                           Margin="0,0,0,6" />

                                                <ItemsControl ItemsSource="{Binding Changes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="·" Margin="0,0,8,0"
                                                                           FontFamily="{StaticResource UiFont}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource TextFaint}" />

                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           FontFamily="{StaticResource UiFont}"
                                                                           FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="ChangelogEmptyText" Style="{StaticResource Placeholder}"
                                           Margin="0,30,0,0"
                                           Text="Diese Fassung ist die öffentliche Version;&#10;es gibt nichts Zusätzliches." />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LogStateText" VerticalAlignment="Center"
                       FontFamily="{StaticResource UiFont}" FontSize="11.5"
                       Foreground="{StaticResource TextFaint}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="LogStateText" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyLogButton" Content="Fehler kopieren"
                        AutomationProperties.AutomationId="CopyLogButton"
                        Click="CopyLog_Click" />
                <Button x:Name="OpenLogButton" Content="Protokolldatei öffnen" Margin="10,0,0,0"
                        AutomationProperties.AutomationId="OpenLogButton"
                        Click="OpenLog_Click" />
                <Button x:Name="ClearLogButton" Content="Protokoll leeren" Margin="10,0,0,0"
                        AutomationProperties.AutomationId="ClearLogButton"
                        Click="ClearLog_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
