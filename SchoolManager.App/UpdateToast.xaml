<Window x:Class="SchoolManager.App.UpdateToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update verfügbar"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Border Style="{StaticResource Card}" Cursor="Hand"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">
        <Grid Margin="16,14,10,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Update verfügbar" FontFamily="{StaticResource UiFont}"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="MessageText" FontFamily="{StaticResource UiFont}" FontSize="12"
                           Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="Klicken, um zu den Einstellungen zu wechseln" FontFamily="{StaticResource UiFont}"
                           FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Top" Padding="6,2" FontSize="11"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>
