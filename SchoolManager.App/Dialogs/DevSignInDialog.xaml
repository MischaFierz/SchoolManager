<Window x:Class="SchoolManager.App.Dialogs.DevSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entwicklermodus"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Als Entwickler anmelden" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Der Entwicklermodus steht nur Konten offen, die im Admin-Panel dafür eingetragen sind." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Benutzername" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UserNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                     MaxLength="64"
                     AutomationProperties.AutomationId="DevUserNameBox" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Passwort" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"
                         MaxLength="200"
                         AutomationProperties.AutomationId="DevPasswordBox" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Foreground="{StaticResource Error}" Visibility="Collapsed"
                       AutomationProperties.AutomationId="DevSignInErrorText" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0"
                        AutomationProperties.AutomationId="DevSignInCancelButton" />
                <Button x:Name="SignInButton" Content="Anmelden" IsDefault="True"
                        Style="{StaticResource AccentButton}"
                        AutomationProperties.AutomationId="DevSignInButton"
                        Click="SignIn_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
