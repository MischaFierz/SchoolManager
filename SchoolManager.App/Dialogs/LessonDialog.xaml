<Window x:Class="SchoolManager.App.Dialogs.LessonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SchoolManager.App.Controls"
        Title="Lektion bearbeiten"
        Width="560" SizeToContent="Height"
        MinHeight="200"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeadingText" Text="Lektion" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fach" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SubjectBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                     AutomationProperties.AutomationId="LessonSubjectBox" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lehrkraft" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TeacherBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="LessonTeacherBox" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="Die Zuordnung gilt für alle Lektionen dieses Fachs, auch für die aus eingelesenen Dateien." />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Wann"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,14,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                <CheckBox x:Name="WeeklyBox" Content="Jede Woche am gleichen Wochentag"
                          AutomationProperties.AutomationId="LessonWeeklyBox"
                          Checked="Weekly_Changed" Unchecked="Weekly_Changed" />

                <StackPanel x:Name="DayPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Wochentag" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                    <ComboBox x:Name="DayBox" Width="160"
                              AutomationProperties.AutomationId="LessonDayBox" />
                </StackPanel>

                <StackPanel x:Name="DatePanel" Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Datum" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                    <c:DateBox x:Name="DateBox" Width="176"
                               AutomationProperties.AutomationId="LessonDateBox" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Zeit" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="StartBox" Width="100" ToolTip="Beginn, Format hh:mm"
                         AutomationProperties.AutomationId="LessonStartBox" />
                <TextBlock Text="Dauer" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                <TextBox x:Name="DurationBox" Width="100" ToolTip="Zum Beispiel 45, 1:30 oder 1,5h"
                         AutomationProperties.AutomationId="LessonDurationBox" />
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Raum" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="RoomBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Width="180"
                     HorizontalAlignment="Left"
                     AutomationProperties.AutomationId="LessonRoomBox" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Notiz"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,14,0" />
            <TextBox x:Name="NoteBox" Grid.Row="6" Grid.Column="1" MinHeight="60"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="LessonNoteBox" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Foreground="{StaticResource Error}"
                       AutomationProperties.AutomationId="LessonErrorText" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0"
                        AutomationProperties.AutomationId="LessonCancelButton" />
                <Button Content="Speichern" IsDefault="True" Style="{StaticResource AccentButton}"
                        AutomationProperties.AutomationId="LessonSaveButton"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
